// ComicAI Prisma 스키마

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  /// citext 다. text 로 두면 `Admin@x.com` 과 `admin@x.com` 이 서로 다른 계정이
  /// 되는데, 운영자 판정은 소문자로 비교해서 대소문자만 바꾼 가입으로 운영자
  /// 권한을 가져갈 수 있었다. 앱(Zod EmailSchema)에서도 정규화하지만 DB 에서 한 번 더 막는다.
  email           String    @unique @db.Citext
  passwordHash    String?
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  avatarStorageKey String?  @map("avatar_storage_key")
  oauthProviders  Json      @default("[]") @map("oauth_providers")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// 약관·개인정보 처리방침 동의 시각. 불리언이 아니라 시각인 이유는
  /// "동의했다"만으로는 언제·어느 판본에 동의했는지 알 수 없기 때문이다.
  /// 문서를 개정해 재동의를 받아야 할 때 이 값이 판단 근거가 된다.
  termsAgreedAt   DateTime? @map("terms_agreed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  apiKeys           ApiKey[]
  projects          Project[]
  renderJobs        RenderJob[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]

  @@map("users")
}

model EmailVerification {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id              String    @id
  userId          String    @map("user_id")
  provider        String
  label           String
  ciphertext      String
  nonce           String
  lastVerifiedAt  DateTime? @map("last_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Project {
  id              String   @id
  userId          String   @map("user_id")
  name            String
  thumbnail       String?
  defaultStyleId  String?  @map("default_style_id")
  defaultModel    String?  @map("default_model")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages       Page[]
  entities    ConsistencyEntity[]

  @@index([userId, createdAt])
  @@map("projects")
}

model ConsistencyEntity {
  id          String   @id
  projectId   String   @map("project_id")
  type        String // 'style' | 'character' | 'background' | 'worldview'
  name        String
  aliases     String[] @default([])
  description String   @default("")
  refImages   Json     @default("[]") @map("ref_images")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("consistency_entities")
}

model Page {
  id         String   @id
  projectId  String   @map("project_id")
  order      Int
  name            String?
  size            Json
  background      Json?
  backgroundColor String?  @map("background_color")
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  panels        Panel[]
  speechBubbles SpeechBubble[]
  pageTexts     PageText[]
  pageLines     PageLine[]

  @@index([projectId, order])
  @@map("pages")
}

model SpeechBubble {
  id        String   @id
  pageId    String   @map("page_id")
  variant   String   // 'ellipse' | 'rect' | 'spike' | 'polygon'
  shape     Json     // { x, y, w, h, points?, tail? }
  style     Json     @default("{}") // SpeechBubbleStyle (모양/선/채움 — 텍스트 없음)
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("speech_bubbles")
}

model PageText {
  id        String   @id
  pageId    String   @map("page_id")
  x         Float
  y         Float
  w         Float
  h         Float
  text      String   @default("")
  style     Json     @default("{}") // PageTextStyle
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("page_texts")
}

model PageLine {
  id        String   @id
  pageId    String   @map("page_id")
  // 두 끝점 (페이지 좌표계 절대값).
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  style     Json     @default("{}") // PageLineStyle (strokeWidth/strokeColor/strokeStyle)
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("page_lines")
}

model Panel {
  id              String  @id
  pageId          String  @map("page_id")
  /// 페이지 안에서의 앞뒤 순서. 없을 때는 findMany 에 orderBy 가 없어서 Postgres 의
  /// 힙 순서가 그대로 나갔고, 그 순서는 UPDATE(이동·렌더 완료)마다 바뀔 수 있었다 —
  /// 겹쳐 둔 컷이 새로고침할 때마다 앞뒤가 뒤바뀌었다. 말풍선·텍스트·직선은 처음부터
  /// 이 컬럼이 있었다.
  order           Int     @default(0)
  shape           Json
  conti           Json?
  text            Json    @default("{}")
  refImages       Json    @default("[]") @map("ref_images")
  /// RenderJob 을 가리키지만 FK 는 걸지 않는다. RenderJob.panelId 가 이미 이 테이블을
  /// 참조하므로 FK 를 걸면 순환이 되고, 그 순환에서 cascade 삭제 순서가 미묘해진다.
  /// 잡을 지우는 경로가 컷 삭제 cascade 하나뿐이라(코드에 renderJob.delete 는 없다)
  /// 컷이 살아 있는 동안 이 값이 dangling 될 수 없다. 읽는 쪽도 잡이 없으면 null 로 흡수한다.
  currentRenderId String? @map("current_render_id")
  styleId         String? @map("style_id")
  history         String[] @default([])

  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  renderJobs RenderJob[]

  @@index([pageId, order])
  @@map("panels")
}

model RenderJob {
  id          String    @id
  panelId     String    @map("panel_id")
  userId      String    @map("user_id")
  model       String
  ir          Json
  status      String
  resultImage Json?     @map("result_image")
  error       Json?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 컷이 사라지면 그 컷의 잡도 사라져야 한다. FK 가 없을 때는 컷(또는 프로젝트)을 지워도
  /// render_jobs 수십 건이 영구히 남았고 — cascade 가 pages→panels 에서 끝난다 —
  /// 그 행들이 가리키는 S3 오브젝트를 되짚을 방법도 사라졌다. 잡을 지우는 코드 경로는
  /// 저장소에 없으므로(renderJob.delete 0건) 이 cascade 가 유일한 수거 수단이다.
  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, createdAt])
  @@index([userId, createdAt])
  @@map("render_jobs")
}
