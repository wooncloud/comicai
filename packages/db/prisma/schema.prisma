// ComicAI Prisma 스키마

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id
  /// citext 다. text 로 두면 `Admin@x.com` 과 `admin@x.com` 이 서로 다른 계정이
  /// 되는데, 운영자 판정은 소문자로 비교해서 대소문자만 바꾼 가입으로 운영자
  /// 권한을 가져갈 수 있었다. 앱(Zod EmailSchema)에서도 정규화하지만 DB 에서 한 번 더 막는다.
  email            String    @unique @db.Citext
  passwordHash     String?
  displayName      String?   @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  avatarStorageKey String?   @map("avatar_storage_key")
  oauthProviders   Json      @default("[]") @map("oauth_providers")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  /// 약관·개인정보 처리방침 동의 시각. 불리언이 아니라 시각인 이유는
  /// "동의했다"만으로는 언제·어느 판본에 동의했는지 알 수 없기 때문이다.
  /// 문서를 개정해 재동의를 받아야 할 때 이 값이 판단 근거가 된다.
  termsAgreedAt    DateTime? @map("terms_agreed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  apiKeys            ApiKey[]
  projects           Project[]
  renderJobs         RenderJob[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  tokenAccount       TokenAccount?
  tokenLedger        TokenLedger[]
  tokenOrders        TokenOrder[]

  @@map("users")
}

model EmailVerification {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id             String    @id
  userId         String    @map("user_id")
  provider       String
  label          String
  ciphertext     String
  nonce          String
  lastVerifiedAt DateTime? @map("last_verified_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Project {
  id             String   @id
  userId         String   @map("user_id")
  name           String
  thumbnail      String?
  defaultStyleId String?  @map("default_style_id")
  defaultModel   String?  @map("default_model")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages    Page[]
  entities ConsistencyEntity[]

  @@index([userId, createdAt])
  @@map("projects")
}

model ConsistencyEntity {
  id          String   @id
  projectId   String   @map("project_id")
  type        String // 'style' | 'character' | 'background' | 'worldview'
  name        String
  aliases     String[] @default([])
  description String   @default("")
  refImages   Json     @default("[]") @map("ref_images")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("consistency_entities")
}

model Page {
  id              String   @id
  projectId       String   @map("project_id")
  order           Int
  name            String?
  size            Json
  background      Json?
  backgroundColor String?  @map("background_color")
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  panels        Panel[]
  speechBubbles SpeechBubble[]
  pageTexts     PageText[]
  pageLines     PageLine[]

  @@index([projectId, order])
  @@map("pages")
}

model SpeechBubble {
  id        String   @id
  pageId    String   @map("page_id")
  variant   String // 'ellipse' | 'rect' | 'spike' | 'polygon'
  shape     Json // { x, y, w, h, points?, tail? }
  style     Json     @default("{}") // SpeechBubbleStyle (모양/선/채움 — 텍스트 없음)
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("speech_bubbles")
}

model PageText {
  id        String   @id
  pageId    String   @map("page_id")
  x         Float
  y         Float
  w         Float
  h         Float
  text      String   @default("")
  style     Json     @default("{}") // PageTextStyle
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("page_texts")
}

model PageLine {
  id        String   @id
  pageId    String   @map("page_id")
  // 두 끝점 (페이지 좌표계 절대값).
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  style     Json     @default("{}") // PageLineStyle (strokeWidth/strokeColor/strokeStyle)
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("page_lines")
}

model Panel {
  id              String   @id
  pageId          String   @map("page_id")
  /// 페이지 안에서의 앞뒤 순서. 없을 때는 findMany 에 orderBy 가 없어서 Postgres 의
  /// 힙 순서가 그대로 나갔고, 그 순서는 UPDATE(이동·렌더 완료)마다 바뀔 수 있었다 —
  /// 겹쳐 둔 컷이 새로고침할 때마다 앞뒤가 뒤바뀌었다. 말풍선·텍스트·직선은 처음부터
  /// 이 컬럼이 있었다.
  order           Int      @default(0)
  shape           Json
  conti           Json?
  text            Json     @default("{}")
  refImages       Json     @default("[]") @map("ref_images")
  /// RenderJob 을 가리키지만 FK 는 걸지 않는다. RenderJob.panelId 가 이미 이 테이블을
  /// 참조하므로 FK 를 걸면 순환이 되고, 그 순환에서 cascade 삭제 순서가 미묘해진다.
  /// 잡을 지우는 경로가 컷 삭제 cascade 하나뿐이라(코드에 renderJob.delete 는 없다)
  /// 컷이 살아 있는 동안 이 값이 dangling 될 수 없다. 읽는 쪽도 잡이 없으면 null 로 흡수한다.
  currentRenderId String?  @map("current_render_id")
  styleId         String?  @map("style_id")
  history         String[] @default([])

  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  renderJobs RenderJob[]

  @@index([pageId, order])
  @@map("panels")
}

model RenderJob {
  id          String    @id
  panelId     String    @map("panel_id")
  userId      String    @map("user_id")
  model       String
  ir          Json
  status      String
  resultImage Json?     @map("result_image")
  error       Json?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 컷이 사라지면 그 컷의 잡도 사라져야 한다. FK 가 없을 때는 컷(또는 프로젝트)을 지워도
  /// render_jobs 수십 건이 영구히 남았고 — cascade 가 pages→panels 에서 끝난다 —
  /// 그 행들이 가리키는 S3 오브젝트를 되짚을 방법도 사라졌다. 잡을 지우는 코드 경로는
  /// 저장소에 없으므로(renderJob.delete 0건) 이 cascade 가 유일한 수거 수단이다.
  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, createdAt])
  @@index([userId, createdAt])
  @@map("render_jobs")
}

/// 토큰 잔액.
///
/// `token_ledger` 의 amount 합과 **항상 같아야 한다.** 그 합을 매번 세지 않는 이유는
/// 두 가지다 — 내역이 쌓이면 읽기가 느려지고, 무엇보다 이 행이 **동시성 통제 지점**이다.
/// 차감은 `UPDATE … WHERE balance >= ?` 한 문장으로 하며, 그 조건이 곧 "잔액보다 많이
/// 쓸 수 없다" 는 보장이다. 애플리케이션에서 읽고-검사하고-쓰면 두 요청이 같은 잔액을
/// 읽어 둘 다 통과한다.
model TokenAccount {
  userId    String   @id @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_accounts")
}

/// 토큰이 움직인 기록. 추가만 하고 고치거나 지우지 않는다.
///
/// 잔액이 틀렸을 때 되짚을 수 있는 유일한 근거이고, 사용자에게 보여 주는 내역이기도 하다.
model TokenLedger {
  id String @id

  userId String @map("user_id")

  /// 양수는 적립, 음수는 차감. 잔액은 이 값들의 합이다.
  amount Int

  /// 이 항목이 반영된 직후의 잔액. 내역 화면이 페이지 단위로 읽으므로 누적합을 다시
  /// 계산할 수 없어서 기록해 둔다. 차감과 같은 트랜잭션에서 UPDATE … RETURNING 으로
  /// 받은 값이라 경쟁 상태에서도 실제 순서와 어긋나지 않는다.
  balanceAfter Int @map("balance_after")

  /// signup_grant | purchase | render | refund | admin_grant | admin_revoke
  kind String

  /// **같은 사건을 두 번 기록하지 않는다.**
  ///
  /// 렌더 워커는 transient 실패를 3회까지 재시도하고, 배포 중 stalled 재큐로 잡이
  /// 되살아나기도 한다. 그때마다 청구하면 그림 한 장에 토큰이 3개 나간다. 예전에는
  /// 이걸 Redis SETNX(26시간 TTL)로 막았는데, 그건 Redis 가 비면 사라지고 환불에는
  /// 쓸 수도 없었다. 여기서는 unique 제약이 영구히 보장한다.
  idempotencyKey String? @unique @map("idempotency_key")

  /// 사람이 읽는 사유. 운영자 지급·회수에서 "왜" 가 없으면 나중에 아무도 모른다.
  memo String?

  /// 연결된 대상(렌더 잡 id, 주문 id). 문의가 들어왔을 때 되짚는 실마리다.
  refId String? @map("ref_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("token_ledger")
}

/// 토큰 구매 주문.
///
/// PG 는 아직 붙지 않았다. `provider` 가 그 자리이고, 지금은 `manual`(운영자가 확인 후
/// 지급) 하나뿐이다. 결제 수단이 생기면 이 모델은 그대로 두고 provider 구현만 추가한다.
model TokenOrder {
  id String @id

  userId String @map("user_id")

  /// 구매 시점의 패키지 id. 패키지 정의가 바뀌어도 이 주문이 무엇이었는지 남는다.
  packageId String @map("package_id")

  /// 지급될 토큰 수와 청구 금액도 **주문 시점 값을 복사해 둔다.** 패키지 표를 참조만
  /// 하면 가격을 올리는 순간 옛 주문의 금액이 함께 바뀌어 영수증이 거짓말이 된다.
  tokens    Int
  amountKrw Int @map("amount_krw")

  /// pending | paid | canceled | failed
  status String

  /// manual | (toss·portone 등이 붙으면 그 이름)
  provider String

  /// PG 쪽 식별자. 대사(對査)에 쓴다.
  providerRef String? @map("provider_ref")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("token_orders")
}
