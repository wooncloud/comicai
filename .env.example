# ---- 데이터베이스 ----
POSTGRES_USER=comicai
POSTGRES_PASSWORD=comicai
POSTGRES_DB=comicai
DATABASE_URL=postgresql://comicai:comicai@localhost:5433/comicai?schema=public

# ---- Redis ----
# 세션과 렌더 큐가 들어 있다. 기본 설정의 redis 는 인증이 없어서,
# 읽히면 남의 세션을 그대로 쓸 수 있다. compose 가 이 값으로 --requirepass 를 건다.
# 생성:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REDIS_PASSWORD=
# 로컬에서 compose 없이 직접 띄울 때만 쓰는 값. compose 는 REDIS_PASSWORD 로 조립한다.
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3 호환) ----
S3_ENDPOINT=http://localhost:9000
# 브라우저가 presigned URL로 직접 다운로드할 때 사용할 외부 host.
# 도커 외부에서 같은 머신이면 localhost:9000, 외부 도메인 노출 시 그 주소로.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=comicai
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- 보안 ----
# MASTER_KEY: API 키 암호화용 KEK (AES-256-GCM). 32바이트 base64.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# ---- 앱 ----
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# 웹의 외부 주소. 이 값 하나가 세 곳을 동시에 정한다 —
# CORS 허용 오리진, OAuth 콜백 리다이렉트 대상, 인증·비밀번호 재설정 메일의 링크.
# 실제 도메인에서 이 값을 빠뜨리면 브라우저가 모든 API 호출을 막는데,
# 서버 로그는 깨끗하고 healthz 도 정상이라 원인을 찾기 어렵다.
WEB_ORIGIN=http://localhost:3000

# 세션 쿠키에 Secure 플래그를 붙일지. **비워 두는 것이 기본이다** —
# 비어 있으면 NODE_ENV=production 일 때 자동으로 켜진다.
# https 가 아닌 곳에서 테스트할 때만 0 을 넣는다. 1/0 을 잘못 박아 두면
# 프로덕션에서 세션 쿠키가 평문으로 나간다.
COOKIE_SECURE=
# web 과 api 를 다른 서브도메인에 둘 때만 부모 도메인을 넣는다 (예: .wooncloud.com).
# 비어 있으면 CSRF 쿠키가 api 호스트에만 붙어, 웹 JS 가 읽지 못해 모든 쓰기가 403 이 된다.
# 로컬(localhost)은 비워 둔다.
COOKIE_DOMAIN=

# ---- 렌더 워커 ----
# compose/full.yml은 worker 컨테이너를 분리하므로 api 쪽은 1, worker 쪽은 0.
# 로컬에서 `pnpm --filter @comicai/api dev`만 띄울 거라면 0으로 두거나, 별도로 `pnpm dev:worker`를 실행해야 렌더가 진행됨.
RENDER_WORKER_DISABLED=0
RENDER_CONCURRENCY=2

# ---- OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:4000

# ---- Cloudflare Tunnel (배포 시에만, profile=tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 백업 (profile=backup) ----
# cron expression — 매일 03:00 KST 기본.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# 컨테이너 기동 즉시 1회 실행할지(테스트용).
BACKUP_RUN_ON_START=0

# 백업 healthcheck: 마지막 성공이 이 시간보다 낡으면 컨테이너가 unhealthy 가 된다.
BACKUP_STALE_HOURS=26
# 백업 실패 알림 (선택). Slack/Discord 웹훅 URL. 비면 로그 + healthcheck 만 남는다.
BACKUP_WEBHOOK_URL=
# 백업 저장 위치 (선택). 기본은 도커 볼륨이라 원본과 **같은 디스크** 에 앉는다.
# 다른 디스크/NAS 마운트 경로를 적으면 그쪽에 쌓인다. 예: /mnt/backup/comicai
BACKUP_HOST_PATH=
# 원격 사본 (선택). 채우면 매 회차 끝에 외부 S3 로 밀어낸다. 디스크가 통째로 죽는
# 경우를 막는 유일한 수단이므로, 운영에 올릴 거면 채우는 쪽을 권한다.
BACKUP_REMOTE_ENDPOINT=
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=comicai

# ---- 운영자 ----
# 관리자 화면(/admin)에 들어갈 수 있는 이메일. 쉼표로 여러 개.
# 비워 두면 아무도 관리자가 아니다 — 깜빡했을 때 전원이 관리자가 되는 것보다 안전하다.
# 저장소가 공개라 코드에 적지 않고 반드시 여기서만 받는다.
ADMIN_EMAILS=

# ---- 관측 ----
# METRICS_TOKEN: /v1/metrics 를 열려면 필요한 Bearer 토큰.
# 비워 두면 아무도 못 본다(404). 메트릭에는 엔드포인트별 실패율과 모델별 총 생성
# 건수가 들어 있어 공개하면 사업 지표가 그대로 나간다.
#   스크레이핑: curl -H "Authorization: Bearer $METRICS_TOKEN" .../v1/metrics
METRICS_TOKEN=

# ---- 기능 플래그 ----
# 켜짐은 1 또는 true. 그 외(빈 값 포함)는 전부 꺼짐.
#
# FEATURE_API_KEYS: 사용자가 자기 AI 서비스 키를 직접 넣는 기능(BYOK).
#   결제 + 사용량 과금으로 방향을 바꾸는 중이라 기본은 꺼짐이다.
#
#   ⚠ 끄면 그림 생성이 멈춘다. 렌더 워커가 사용자 키를 DB 에서 찾아 쓰는데
#     (apps/api/src/render/render.worker.ts 의 resolveApiKey), 키를 등록할 화면이
#     사라지므로 이미 키를 넣어 둔 사용자만 계속 그림을 만들 수 있다.
#     플랫폼 키/과금이 붙기 전까지 서비스를 운영한다면 1 로 두어야 한다.
#
#   서버와 웹 둘 다 켜야 한다. 한쪽만 켜면 화면은 있는데 API 가 404 이거나,
#   화면은 없는데 API 는 열린 상태가 된다.
FEATURE_API_KEYS=0
NEXT_PUBLIC_FEATURE_API_KEYS=0

# ---- 메일 발송 ----
# 없으면 콘솔 로그로만 남는다 — 그 상태에서는 이메일 인증과 비밀번호 재설정을
# 끝낼 수 없다. https://resend.com 에서 발급.
RESEND_API_KEY=
# 발신 주소. 도메인 인증 전에는 Resend 의 테스트 주소를 쓸 수 있다.
EMAIL_FROM=ComicAI <onboarding@resend.dev>

# ---- 플랫폼 AI 키 ----
# 사용자가 자기 키를 넣지 않았을 때 쓰는 회사 키. 비워 두면 사용자 키가 없는
# 사람은 그림을 만들 수 없다(에러로 명확히 알려 준다).
PLATFORM_GEMINI_KEY=
PLATFORM_OPENAI_KEY=
# 플랫폼 키를 쓸 때 한 사람이 하루에 만들 수 있는 그림 수.
# 0 이면 무제한 — 지출 상한이 사라지므로 권장하지 않는다.
# 사용자가 자기 키를 넣었으면 이 상한은 적용되지 않는다(비용을 본인이 낸다).
PLATFORM_DAILY_RENDER_LIMIT=20
