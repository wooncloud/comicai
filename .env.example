# 비밀값 전용. `cp .env.example .env` 후 채우세요.
#
# ─────────────────────────────────────────────────────────────────────────────
# 설정값은 여기 없습니다. `env-profile.json` 에 있고 그 파일은 커밋됩니다.
#
#   포트·주소·로그 레벨·기능 플래그·백업 주기  →  env-profile.json (dev / prod 그룹)
#   비밀번호·API 키·토큰·계좌·관리자 이메일     →  이 파일
#
# 나눈 이유: 섞여 있으면 둘 다 커밋할 수 없어서, "프로덕션이 지금 어떤 설정으로
# 도는가" 를 저장소에서 읽을 수 없습니다. 실제로 그 상태에서 프로덕션의 WEB_ORIGIN 이
# localhost 인 것을 한동안 아무도 몰랐습니다.
#
# 우선순위는 위가 이깁니다:  실제 환경변수  >  .env  >  env-profile.json
# 그래서 여기에 설정 키를 다시 적으면 이 머신에서만 그 값이 쓰입니다.
#
#   pnpm env:show      현재 그룹의 설정값 보기
#   pnpm env:check     .env 와 겹치는 값 / dev·prod 차이 점검
# ─────────────────────────────────────────────────────────────────────────────

# ---- 데이터베이스 ----
POSTGRES_PASSWORD=comicai
DATABASE_URL=postgresql://comicai:comicai@localhost:5433/comicai?schema=public

# ---- Redis ----
# 세션과 렌더 큐가 들어 있다. 기본 설정의 redis 는 인증이 없어서,
# 읽히면 남의 세션을 그대로 쓸 수 있다. compose 가 이 값으로 --requirepass 를 건다.
# 생성:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REDIS_PASSWORD=
# compose 없이 로컬에서 직접 띄울 때만 쓰는 값. 컨테이너 안에서는 compose 가
# REDIS_PASSWORD 로 조립한다.
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3 호환) ----
# 호스트에서 직접 띄울 때의 접속 주소. 컨테이너 안에서는 compose 가 minio:9000 을 넣는다
# (도커 네트워크 사정이라 프로파일이 아니라 compose 가 안다).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- 보안 ----
# MASTER_KEY: API 키 암호화용 KEK (AES-256-GCM). 32바이트 base64.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# ---- OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Cloudflare Tunnel (배포 시에만, profile=tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 백업 원격 사본 (선택, profile=backup) ----
# 주기·보관 기간·저장 위치는 env-profile.json 에 있다. 여기는 자격 증명만.
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
# 실패 알림 Slack/Discord 웹훅 URL. 비면 로그 + healthcheck 만 남는다.
BACKUP_WEBHOOK_URL=

# ---- 운영자 ----
# 관리자 화면(/admin)에 들어갈 수 있는 이메일. 쉼표로 여러 개.
# 비워 두면 아무도 관리자가 아니다 — 깜빡했을 때 전원이 관리자가 되는 것보다 안전하다.
# 저장소가 공개라 코드에도 env-profile.json 에도 적지 않고 반드시 여기서만 받는다.
ADMIN_EMAILS=

# ---- 관측 ----
# METRICS_TOKEN: /v1/metrics 를 열려면 필요한 Bearer 토큰.
# 비워 두면 아무도 못 본다(404). 메트릭에는 엔드포인트별 실패율과 모델별 총 생성
# 건수가 들어 있어 공개하면 사업 지표가 그대로 나간다.
#   스크레이핑: curl -H "Authorization: Bearer $METRICS_TOKEN" .../v1/metrics
METRICS_TOKEN=

# ---- 메일 발송 ----
# 없으면 콘솔 로그로만 남는다 — 그 상태에서는 이메일 인증과 비밀번호 재설정을
# 끝낼 수 없다. https://resend.com 에서 발급.
# 발신 주소(EMAIL_FROM)는 비밀이 아니라 env-profile.json 에 있다.
RESEND_API_KEY=

# ---- 플랫폼 AI 키 ----
# 사용자가 자기 키를 넣지 않았을 때 쓰는 회사 키. 비워 두면 사용자 키가 없는
# 사람은 그림을 만들 수 없다(에러로 명확히 알려 준다).
#
# 지출 상한은 토큰이 맡는다 — 발행한 토큰(가입 지급 + 구매)보다 많이 쓸 수 없으므로
# 하루 상한 같은 별도 설정이 필요 없다. 모델별 단가는 `MODEL_TOKEN_COST`,
# 가입 지급량은 `SIGNUP_GRANT_TOKENS`(둘 다 packages/types) 에 있다.
PLATFORM_GEMINI_KEY=
PLATFORM_OPENAI_KEY=

# 랜딩 샘플 생성 스크립트(scripts/gen-landing-samples.ts)가 .env 에서 직접 읽는다.
GEMINI_API_KEY=

# ---- 충전 안내 ----
# **비워 두면 충전 요청 자체를 받지 않는다** — 어디로 얼마를 보내야 하는지 말해 줄 수
# 없으면, 주문을 받아 봐야 사용자는 다음에 할 일이 없다(성공한 것처럼 보여서 버튼이
# 없는 것보다 나쁘다). PG 를 붙이면 이 값을 비우고 결제 흐름으로 바꾼다.
# 저장소가 공개라 계좌 정보는 코드에도 env-profile.json 에도 둘 수 없다.
# 예: 국민 123456-78-901234 (예금주 …) 로 입금 후 회신 주시면 확인 뒤 지급합니다.
BILLING_NOTICE=
