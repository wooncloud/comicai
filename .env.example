# ---- 데이터베이스 ----
POSTGRES_USER=comicai
POSTGRES_PASSWORD=comicai
POSTGRES_DB=comicai
DATABASE_URL=postgresql://comicai:comicai@localhost:5433/comicai?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3 호환) ----
S3_ENDPOINT=http://localhost:9000
# 브라우저가 presigned URL로 직접 다운로드할 때 사용할 외부 host.
# 도커 외부에서 같은 머신이면 localhost:9000, 외부 도메인 노출 시 그 주소로.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=comicai
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- 보안 ----
# MASTER_KEY: API 키 암호화용 KEK (AES-256-GCM). 32바이트 base64.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# 세션 쿠키 서명 (32바이트 random hex 권장)
SESSION_SECRET=

# ---- 앱 ----
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# 운영에서 web/api 가 서로 다른 서브도메인이면 부모 도메인으로 스코프 필요
# (예: .wooncloud.com). 로컬 (localhost) 은 비워둠.
COOKIE_DOMAIN=

# ---- 렌더 워커 ----
# compose/full.yml은 worker 컨테이너를 분리하므로 api 쪽은 1, worker 쪽은 0.
# 로컬에서 `pnpm --filter @comicai/api dev`만 띄울 거라면 0으로 두거나, 별도로 `pnpm dev:worker`를 실행해야 렌더가 진행됨.
RENDER_WORKER_DISABLED=0
RENDER_CONCURRENCY=2

# ---- OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:4000

# ---- Cloudflare Tunnel (배포 시에만, profile=tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 백업 (profile=backup) ----
# cron expression — 매일 03:00 KST 기본.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# 컨테이너 기동 즉시 1회 실행할지(테스트용).
BACKUP_RUN_ON_START=0

# ---- 운영자 ----
# 관리자 화면(/admin)에 들어갈 수 있는 이메일. 쉼표로 여러 개.
# 비워 두면 아무도 관리자가 아니다 — 깜빡했을 때 전원이 관리자가 되는 것보다 안전하다.
# 저장소가 공개라 코드에 적지 않고 반드시 여기서만 받는다.
ADMIN_EMAILS=

# ---- 기능 플래그 ----
# 켜짐은 1 또는 true. 그 외(빈 값 포함)는 전부 꺼짐.
#
# FEATURE_API_KEYS: 사용자가 자기 AI 서비스 키를 직접 넣는 기능(BYOK).
#   결제 + 사용량 과금으로 방향을 바꾸는 중이라 기본은 꺼짐이다.
#
#   ⚠ 끄면 그림 생성이 멈춘다. 렌더 워커가 사용자 키를 DB 에서 찾아 쓰는데
#     (apps/api/src/render/render.worker.ts 의 resolveApiKey), 키를 등록할 화면이
#     사라지므로 이미 키를 넣어 둔 사용자만 계속 그림을 만들 수 있다.
#     플랫폼 키/과금이 붙기 전까지 서비스를 운영한다면 1 로 두어야 한다.
#
#   서버와 웹 둘 다 켜야 한다. 한쪽만 켜면 화면은 있는데 API 가 404 이거나,
#   화면은 없는데 API 는 열린 상태가 된다.
FEATURE_API_KEYS=0
NEXT_PUBLIC_FEATURE_API_KEYS=0
